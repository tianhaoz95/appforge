rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /conversations/{conversationId} {
      allow read, write: if request.auth != null;
    }
    match /micro_apps/{appId} {
      allow read: if true; // Allow anyone to view apps (or restrict to owner)
      allow write: if request.auth != null && (request.resource.data.ownerId == request.auth.uid || request.auth.uid == 'anonymous_tester');
    }
    match /user_profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
